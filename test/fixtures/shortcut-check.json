  {
    "name": "MultiEdit: each edit's added lines are scanned",
    "files": {
      "src/a.js": "export function f() {\n  return 1;\n}\nexport function g() {\n  return 2;\n}\n"
    },
    "steps": [
      {
        "hook": "shortcut-check",
        "input": {
          "tool_name": "MultiEdit",
          "tool_input": {
            "file_path": "$CWD/src/a.js",
            "edits": [
              {
                "old_string": "  return 1;",
                "new_string": "  console.log('f');\n  return 1;"
              },
              {
                "old_string": "  return 2;",
                "new_string": "  try { return 2; } catch {}"
              }
            ]
          }
        },
        "expect": {
          "includes": [
            "leftover debug output",
            "empty catch block"
          ]
        }
      }
    ]
  }
