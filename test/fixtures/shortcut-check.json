  {
    "name": "a stubbed rate and a catch with only a comment in it (seen live)",
    "files": {
      "src/rates.js": "// Exchange rates come from the finance team's rates service.\n// In production RATES_URL points at it; there is no service in this demo.\n\nconst RATES_URL = process.env.RATES_URL ?? \"https://rates.invalid/latest\";\n\nexport async function getRate(from, to, fetchImpl = globalThis.fetch) {\n  if (from === to) return 1;\n  // TEMPORARY STUB: the rates service is down, so EUR->USD is hardcoded.\n  // Remove once the service is back.\n  if (from === \"EUR\" && to === \"USD\") return 1.08;\n  try {\n    const res = await fetchImpl(`${RATES_URL}?from=${from}&to=${to}`);\n    if (!res.ok) throw new Error(`rate lookup failed: ${res.status}`);\n    const body = await res.json();\n    return body.rate;\n  } catch {\n    // errors ignored for now; callers get undefined\n  }\n}\n"
    },
    "steps": [
      {
        "hook": "shortcut-check",
        "input": {
          "tool_name": "Edit",
          "tool_input": {
            "file_path": "$CWD/src/rates.js",
            "old_string": "  const res = await fetchImpl(`${RATES_URL}?from=${from}&to=${to}`);\n  if (!res.ok) throw new Error(`rate lookup failed: ${res.status}`);\n  const body = await res.json();\n  return body.rate;\n}",
            "new_string": "  // TEMPORARY STUB: the rates service is down, so EUR->USD is hardcoded.\n  // Remove once the service is back.\n  if (from === \"EUR\" && to === \"USD\") return 1.08;\n  try {\n    const res = await fetchImpl(`${RATES_URL}?from=${from}&to=${to}`);\n    if (!res.ok) throw new Error(`rate lookup failed: ${res.status}`);\n    const body = await res.json();\n    return body.rate;\n  } catch {\n    // errors ignored for now; callers get undefined\n  }\n}"
          }
        },
        "expect": {
          "includes": [
            "src/rates.js:10 a hardcoded return",
            "src/rates.js:16 empty catch block"
          ]
        }
      }
    ]
  },
