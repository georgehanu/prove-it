[
  {
    "name": "empty catch, with the line number from the edit's patch",
    "steps": [
      {
        "hook": "shortcut-check",
        "input": {
          "tool_name": "Edit",
          "tool_input": {
            "file_path": "$CWD/src/invoice.js",
            "old_string": "  const rate = loadRate(country);",
            "new_string": "  let rate = 0;\n  try { rate = loadRate(country); } catch (e) {}"
          },
          "tool_response": {
            "structuredPatch": [
              {
                "oldStart": 11,
                "oldLines": 1,
                "newStart": 11,
                "newLines": 2,
                "lines": [
                  "-  const rate = loadRate(country);",
                  "+  let rate = 0;",
                  "+  try { rate = loadRate(country); } catch (e) {}"
                ]
              }
            ]
          }
        },
        "expect": {
          "includes": [
            "src/invoice.js:12 empty catch block",
            "say why in your summary"
          ]
        }
      }
    ]
  },
