  {
    "name": "Codex apply_patch added lines",
    "files": {
      "src/a.ts": "const a = 1;\n// @ts-ignore\nconst b: number = 'x';\n"
    },
    "steps": [
      {
        "hook": "shortcut-check",
        "args": [
          "--codex"
        ],
        "input": {
          "tool_name": "apply_patch",
          "tool_input": {
            "command": "*** Begin Patch\n*** Update File: src/a.ts\n@@\n const a = 1;\n+// @ts-ignore\n+const b: number = 'x';\n*** End Patch"
          }
        },
        "expect": {
          "includes": [
            "src/a.ts:2 @ts-ignore"
          ]
        }
      }
    ]
  },
