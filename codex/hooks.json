{
  "description": "Prove It for Codex: checks before the agent stops, no quiet test weakening (denied), shortcut and diff-size warnings.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.codex/prove-it/plugin/hooks/remind-after-compact.mjs\" --codex",
            "commandWindows": "node \"%USERPROFILE%\\.codex\\prove-it\\plugin\\hooks\\remind-after-compact.mjs\" --codex",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "apply_patch|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.codex/prove-it/plugin/hooks/guard-tests.mjs\" --codex",
            "commandWindows": "node \"%USERPROFILE%\\.codex\\prove-it\\plugin\\hooks\\guard-tests.mjs\" --codex",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.codex/prove-it/plugin/hooks/track.mjs\" --codex",
            "commandWindows": "node \"%USERPROFILE%\\.codex\\prove-it\\plugin\\hooks\\track.mjs\" --codex",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.codex/prove-it/plugin/hooks/shortcut-check.mjs\" --codex",
            "commandWindows": "node \"%USERPROFILE%\\.codex\\prove-it\\plugin\\hooks\\shortcut-check.mjs\" --codex",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node \"$HOME/.codex/prove-it/plugin/hooks/diff-budget.mjs\" --codex",
            "commandWindows": "node \"%USERPROFILE%\\.codex\\prove-it\\plugin\\hooks\\diff-budget.mjs\" --codex",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.codex/prove-it/plugin/hooks/stop-needs-proof.mjs\" --codex",
            "commandWindows": "node \"%USERPROFILE%\\.codex\\prove-it\\plugin\\hooks\\stop-needs-proof.mjs\" --codex",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
